<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash shows no icon (the eagle alone was a second logo before the app's own
         ICR splash, owner 9 Nov 2026); a plain white window until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
