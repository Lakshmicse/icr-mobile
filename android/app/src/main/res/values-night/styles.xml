<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts, with the phone in Dark Mode. Light all the same: the app has no dark
         theme yet (owner, 13 Nov 2026), so the launch window is white before the white ICR splash, not black. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window behind the Flutter UI once it runs: white too. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
