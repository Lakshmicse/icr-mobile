   "topicId": "cmv6lucsg0342myt8nhfm267o",
   "front": "Straight Line Depreciation (SLM)",
   "back": "$$Annual Depreciation = Asset Cost−Salvage Value​\\div Useful Life$$",
   "example": "",
   "examples": [
    {
     "given": [
      {
       "label": "Asset Cost",
       "value": "₹1,20,00,000"
      },
      {
       "label": "Salvage Value",
       "value": "₹20,00,000"
      },
      {
       "label": "Useful Life",
       "value": "10 Years"
      },
      {
       "label": "Annual Depreciation",
       "value": "(120−20)/10"
      }
     ],
     "working": ": ₹10,00,000/year",
     "analysis": "₹70 Lakhs of depreciable cost is distributed equally across 5 years",
     "decision": "₹10 lakh per year as depreciation under the stated SLM assumptions."
    },
    {
     "given": [],
     "working": "Asset cost = ₹80 lakh\nSalvage value = ₹8 lakh\nUseful life = 8 years\nAnnual Depreciation : (80−8)/8\n: ₹9L/year​",
     "analysis": "₹72 lakh of depreciable cost is distributed equally across eight years.",
     "decision": "Annual SLM depreciation should be ₹9 lakh."
    }
   ],
