   "topicId": "cmv6lucsg0342myt8nhfm267o",
   "front": "Double Declining Balance (DDB)",
   "back": "$$Depreciation=(2 \\div Useful Life​)×Opening Book Value$$",
   "example": "",
   "examples": [
    {
     "given": [
      {
       "label": "Equipment Cost",
       "value": "₹100 Lakhs"
      },
      {
       "label": "Life",
       "value": "10 Years"
      },
      {
       "label": "Rate",
       "value": "20%"
      },
      {
       "label": "Year 1",
       "value": "100×20% :  ₹20 Lakhs"
      },
      {
       "label": "Book Value",
       "value": "₹80 Lakhs"
      }
     ],
     "analysis": "DDB applies the accelerated 20% rate to the opening book value. This creates higher depreciation in the earlier years.",
     "decision": "Year 1 depreciation = ₹20 lakh, with closing book value of ₹80 lakh."
    },
    {
     "given": [
      {
       "label": "Opening book value",
       "value": "₹80 lakh"
      },
      {
       "label": "Useful life",
       "value": "10 years"
      },
      {
       "label": "DDB rate",
       "value": "20%"
      },
      {
       "label": "Depreciation",
       "value": "80×20% : ₹16L"
      },
      {
       "label": "Closing book value",
       "value": "80−16 : ₹64L"
      }
     ],
     "working": "​\n​",
     "analysis": "The depreciation expense falls because DDB applies the same rate to a declining book value.",
     "decision": "Year 2 depreciation = ₹16 lakh, with closing book value of ₹64 lakh."
    }
   ],
