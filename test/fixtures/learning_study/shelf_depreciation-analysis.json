   "topicId": "cmv6lucsg0342myt8nhfm267o",
   "front": "Depreciated Replacement Cost (DRC)",
   "back": "$$DRC=Replacement Cost× Remaining Useful Life​ \\div Total Useful Life$$",
   "example": "",
   "examples": [
    {
     "given": [
      {
       "label": "Replacement Cost",
       "value": "₹10 Crores"
      },
      {
       "label": "Useful Life",
       "value": "25 Years"
      },
      {
       "label": "Remaining Life",
       "value": "10 Years"
      },
      {
       "label": "DRC",
       "value": "10×10/25 : ₹4 Crores"
      }
     ],
     "analysis": "DRC estimates the current value of an existing asset after considering depreciation. It is widely used for insurance, asset valuation, capital planning, and public infrastructure.",
     "decision": "DRC under the formula provided = ₹4 crore."
    },
    {
