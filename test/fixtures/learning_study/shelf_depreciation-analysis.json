       "label": "Year 1",
       "value": "5/15 ×60 : ₹20 Lakhs"
      },
      {
       "label": "Year 2",
       "value": "4/15 ×60 :  ₹16 Lakhs"
      }
     ],
     "analysis": "SYD allocates a larger proportion of the depreciable amount to the early years.",
     "decision": "Year 1 depreciation = ₹16.67 lakh."
    },
    {
     "given": [
      {
       "label": "Cost",
       "value": "₹60 lakh"
      },
      {
       "label": "Salvage value",
       "value": "₹10 lakh"
      },
      {
       "label": "Useful life",
       "value": "5 years."
      },
      {
       "label": "Year 2 remaining life",
       "value": "4"
      },
      {
       "label": "Depreciation",
       "value": "₹13.33L"
      }
     ],
     "working": "​",
     "analysis": "Year 2 depreciation is lower than Year 1 because the remaining-life fraction decreases from \\(5/15\\) to \\(4/15\\).",
     "decision": "Year 2 depreciation = ₹13.33 lakh."
    }
   ],
