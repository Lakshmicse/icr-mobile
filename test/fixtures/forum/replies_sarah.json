   "children": []
  },
  {
   "id": "design-home-reply-sarah-f2",
   "threadId": "design-home-thread-sarah",
   "parentId": null,
   "bodyHtml": "<p>Check whether your BMS exposes BACnet/IP or only MS/TP. That decides whether you need a gateway or can integrate directly.</p>",
   "moderation": "APPROVED",
   "author": {
    "id": "design-home-user-arvind",
    "firstName": "Arvind",
    "lastName": "Swamy",
    "avatarUrl": "/uploads/design-home-avatar_arvind.jpg",
    "headline": "General Counsel at Brookfield Properties",
    "reputation": 0
   },
   "score": 1,
