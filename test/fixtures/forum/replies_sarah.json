  },
  {
   "id": "design-home-reply-sarah-f11",
   "threadId": "design-home-thread-sarah",
   "parentId": null,
   "bodyHtml": "<p>A shortlist of two or three integrators who have done your BMS brand before is worth more than any feature list.</p>",
   "moderation": "APPROVED",
   "author": {
    "id": "cmvar8d6l0010mymk19peyyqp",
    "firstName": "Deepa",
    "lastName": "Iyer",
    "avatarUrl": "/uploads/seed-avatar-female-12.jpg",
    "headline": "Health, safety and business continuity for industrial facilities",
    "reputation": 0
