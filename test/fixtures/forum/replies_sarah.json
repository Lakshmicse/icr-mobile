  {
   "id": "design-home-reply-sarah-f4",
   "threadId": "design-home-thread-sarah",
   "parentId": null,
   "bodyHtml": "<p>Vendor-neutral protocols first, dashboards second. We've been burned by a pretty UI on a closed stack.</p>",
   "moderation": "APPROVED",
   "author": {
    "id": "cmvar8d3x000jmymk87mpculi",
    "firstName": "Vikram",
    "lastName": "Desai",
    "avatarUrl": "/uploads/seed-avatar-male-16.jpg",
    "headline": "Smart buildings, BMS and the IoT retrofit nobody warned you about",
    "reputation": 0
