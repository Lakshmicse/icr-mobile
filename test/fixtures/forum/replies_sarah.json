    {
     "id": "design-home-reply-sarah-r6",
     "threadId": "design-home-thread-sarah",
     "parentId": "design-home-reply-sarah-r1",
     "bodyHtml": "<p>Ask each vendor for their BACnet PICS before you shortlist. It saves a lot of arguing later.</p>",
     "moderation": "APPROVED",
     "author": {
      "id": "cmvar8d2r0007mymkx6nyyq5j",
      "firstName": "Rajesh",
