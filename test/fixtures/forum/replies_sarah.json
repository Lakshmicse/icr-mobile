    {
     "id": "design-home-reply-sarah-r8",
     "threadId": "design-home-thread-sarah",
     "parentId": "design-home-reply-sarah-r1",
     "bodyHtml": "<p>Put data ownership in the contract, not just the integration scope.</p>",
     "moderation": "APPROVED",
     "author": {
      "id": "cmvar8d64000vmymk0l4qsyop",
      "firstName": "Sanjay",
      "lastName": "Kulkarni",
