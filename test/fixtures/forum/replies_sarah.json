   "children": []
  },
  {
   "id": "design-home-reply-sarah-f7",
   "threadId": "design-home-thread-sarah",
   "parentId": null,
   "bodyHtml": "<p>Ask who owns the data and where it lives. Several of the cheaper vendors keep it in their own cloud.</p>",
   "moderation": "APPROVED",
   "author": {
    "id": "cmvar8d64000vmymk0l4qsyop",
